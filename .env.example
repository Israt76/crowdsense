# CrowdSense configuration. Copy to .env and fill in what you need.
# .env is git-ignored. Nothing here is ever sent to the overlay or panel pages.

# --- Live chat (npm start) ---------------------------------------------------
# Channel to read. Public chat can be read anonymously, so this is the only
# required value for live mode.
TWITCH_CHANNEL=

# Optional: read as a specific account instead of anonymously.
# Create a user access token with the chat:read scope. Never commit it.
TWITCH_USERNAME=
TWITCH_OAUTH_TOKEN=

# --- Server ------------------------------------------------------------------
PORT=7070
# 127.0.0.1 = only this computer. Use 0.0.0.0 to let others on your network
# open /lab for a human typing test (set PANEL_TOKEN when you do).
HOST=127.0.0.1
# If set, the control API (HEARD, dismiss, context, lab messages) requires it:
# open /panel?token=... and /lab?token=...
PANEL_TOKEN=

# --- Privacy-conscious logging for replay / human stress tests ---------------
# 1 = write anonymized chat logs to data/logs/ (user ids hashed, @mentions removed)
RECORD_LOGS=0
# Secret salt for the user-id hash. Keep it private; without it hashes can't be linked to accounts.
LOG_SALT=

# --- Demo ----------------------------------------------------------------------
DEMO_SEED=7
